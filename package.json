{
  "name": "@smartrsolutions/andon-client",
  "version": "1.0.1",
  "description": "Send values from Node.js to the Andon app for iPhone and iPad: end-to-end encrypted tiles and widgets.",
  "keywords": [
    "andon",
    "iphone",
    "ipad",
    "dashboard",
    "widget",
    "iot"
  ],
  "license": "MIT",
  "author": "SMARTR.solutions",
  "homepage": "https://andon.app/en/developers",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smartrsolutions/andon-client.git"
  },
  "bugs": {
    "email": "support@andon.app"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "schema/",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test": "npm run build && node --test"
  },
  "devDependencies": {
    "@types/node": "18.19.130",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  }
}
